# === macOS ===
.DS_Store

# === Claude Code ===
.claude/

# === Packwiz build output ===
*.mrpack

# === Player-specific Xaero map data ===
# These are generated per-player and should not be part of the modpack
xaero/minimap/Multiplayer_*/
xaero/world-map/Multiplayer_*/
*.xwmc
*.xwmc.outdated
*.lock

# === Minecraft backup files ===
servers.dat_old
*.backup*

# === Per-installation generated files ===
config/sodium-fingerprint.json

# === Shader pack binaries (downloaded by packwiz at runtime) ===
shaderpacks/*.zip

# === Mod JAR files (downloaded by packwiz at runtime) ===
mods/*.jar

# === Minecraft runtime directories ===
logs/
crash-reports/
saves/
screenshots/
.fabric/
*.log

# === Java ===
*.class


# Per-device scoped marker credential (never distribute).
config/entegre-markers/
marker-sync/.gradle/
marker-sync/build/
marker-sync/run/

# Locally built Entegre bridge is bundled; downloaded third-party JARs remain excluded.
!mods/entegre-markers-0.2.1.jar


# Python maintenance cache
__pycache__/
*.pyc

# The client transition is bundled; rollback state remains local.
!mods/entegre-updater-transition-0.1.0.jar
entegre-updater/*backup*
.entegre-updater-disabled
.entegre-bootstrap-*
